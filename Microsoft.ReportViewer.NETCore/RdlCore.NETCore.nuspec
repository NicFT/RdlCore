<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>RdlCore.NETCore</id>
    <version>15.1.33</version>
    <authors>Microsoft, lkosson, ShadowedMists</authors>
    <owners>Microsoft, lkosson, ShadowedMists</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/ShadowedMists/RdlCore</projectUrl>
    <description>SQL Server Reporting Services engine decompiled and recompiled for .NET 8. Based on ReportViewer 15.0.1404.0</description>
    <tags>ReportViewer Report Viewer Reporting Services ReportingServices SSRS RDLC RDL Reporting PDF Microsoft .Net Core NetCore AspNetCore</tags>
    <icon>images\icon.png</icon>
    <readme>docs\README.md</readme>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.CodeAnalysis.VisualBasic" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="System.CodeDom" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="System.IO.Packaging" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Drawing.Common" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Resources.Extensions" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="System.ServiceModel.Http" version="10.0.652802" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
  <files>
     <file src="bin\Release\net10.0\Microsoft.ReportViewer.NETCore.dll" target="lib\net10.0"></file>
     <file src="bin\Release\net10.0\Microsoft.ReportViewer.Common.dll" target="lib\net10.0"></file>
     <file src="bin\Release\net10.0\Microsoft.ReportViewer.DataVisualization.dll" target="lib\net10.0"></file>
     <file src="bin\Release\net10.0\Microsoft.ReportViewer.ProcessingObjectModel.dll" target="lib\net10.0"></file>
     <file src="bin\Release\net10.0\**\*.resources.dll" target="lib\net10.0"></file>
     <file src="bin\Release\net10.0\runtimes\**\*.*" target="runtimes"></file>
     <file src="..\icon.png" target="images\"></file>
     <file src="README.md" target="docs\"></file>
  </files>
</package>