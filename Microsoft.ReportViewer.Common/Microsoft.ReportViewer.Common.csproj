<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>Microsoft.ReportViewer.Common</AssemblyName>
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>
	<PropertyGroup>
		<LangVersion>10.0</LangVersion>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<RootNamespace></RootNamespace>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>..\RdlCore.snk</AssemblyOriginatorKeyFile>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<EmbeddedResource Include="**\*.gif" />
		<EmbeddedResource Include="**\*.js" />
		<EmbeddedResource Include="**\*.js_Debug" />
		<EmbeddedResource Include="**\*.css" />
		<EmbeddedResource Include="**\*.xsd">
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.0.0" />
		<PackageReference Include="OpenMcdf" Version="3.2.0" />
		<PackageReference Include="System.CodeDom" Version="10.0.0" />
		<PackageReference Include="System.IO.Packaging" Version="10.0.0" />
		<PackageReference Include="ClosedXML" Version="0.96.0" />
		<PackageReference Include="PdfSharpCore" Version="1.2.0" />
		<!-- PdfSharpCore 1.2.0 transitively requires SixLabors.ImageSharp 1.0.0-rc0003, which has
         known CVEs. No code in this project uses ImageSharp directly (replaced by SkiaSharp,
         docs/decisions.md), but this pin overrides NuGet's nearest-wins resolution so the
         vulnerable transitive version is never the one that ships. -->
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
		<!-- Cross-platform PDF text shaping (tasks/pdf-text-shaping-abstraction.md, P4
         font layer): version matches Microsoft.ReportViewer.DataVisualization's
         existing SkiaSharp reference. -->
		<PackageReference Include="SkiaSharp" Version="3.119.1" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
		<PackageReference Include="HarfBuzzSharp" Version="8.3.1.2" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.2" />
		<PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.1" />

	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Microsoft.ReportViewer.DataVisualization\Microsoft.ReportViewer.DataVisualization.csproj" />
		<ProjectReference Include="..\Microsoft.ReportViewer.ProcessingObjectModel\Microsoft.ReportViewer.ProcessingObjectModel.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="System.Web.Services">
			<HintPath>C:\Windows\Microsoft.NET\assembly\GAC_MSIL\System.Web.Services\v4.0_4.0.0.0__b03f5f7f11d50a3a\System.Web.Services.dll</HintPath>
		</Reference>
	</ItemGroup>
</Project>