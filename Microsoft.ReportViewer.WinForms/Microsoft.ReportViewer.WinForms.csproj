<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.ReportViewer.WinForms</AssemblyName>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows7</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>10.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <RootNamespace></RootNamespace>
    <PackageId>RdlCore.WinForms</PackageId>
    <Authors>Microsoft, lkosson, ShadowedMists</Authors>
    <PackageProjectUrl>https://github.com/ShadowedMists/RdlCore</PackageProjectUrl>
    <Version>15.1.33</Version>
    <Company>Microsoft</Company>
    <Product>RdlCore</Product>
    <Description>SQL Server Reporting Services WinForms ReportViewer decompiled and recompiled for .NET 10. Based on ReportViewer 15.0.1404.0</Description>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\RdlCore.snk</AssemblyOriginatorKeyFile>
    <!-- NU1510 flags System.Security.Cryptography.Xml below as an apparently-unused direct
         reference, but it's a deliberate pin (see commit af09b43): System.ServiceModel.Http
         transitively pulls in a vulnerable 10.0.0 release, and this direct reference forces
         resolution to the patched 10.0.10 instead. Per-PackageReference NoWarn doesn't
         suppress this particular restore warning, hence the project-level NoWarn here. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="**\*.gif" />
    <EmbeddedResource Include="**\*.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="10.1.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Microsoft.ReportViewer.Common\Microsoft.ReportViewer.Common.csproj" />
  </ItemGroup>
</Project>